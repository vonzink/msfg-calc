<div class="calc-page apr-page">
  <div class="calc-page__header">
    <h1>APR Calculator</h1>
    <p>Annual Percentage Rate per Reg Z with loan-type-aware fee classification.</p>
  </div>

  <!-- Sticky Results Strip -->
  <div class="apr-sticky">
    <div class="apr-sticky__cell">
      <span class="apr-sticky__label">APR</span>
      <span class="apr-sticky__value apr-sticky__value--lg" id="aprResult">0.000%</span>
    </div>
    <div class="apr-sticky__cell">
      <span class="apr-sticky__label">Note Rate</span>
      <span class="apr-sticky__value" id="noteRateDisplay">0.000%</span>
    </div>
    <div class="apr-sticky__cell">
      <span class="apr-sticky__label">Spread</span>
      <span class="apr-sticky__value" id="aprSpread">+0.000%</span>
    </div>
    <div class="apr-sticky__cell">
      <span class="apr-sticky__label">Monthly P&amp;I</span>
      <span class="apr-sticky__value" id="monthlyPayment">$0.00</span>
    </div>
    <div class="apr-sticky__cell">
      <span class="apr-sticky__label">Amount Financed</span>
      <span class="apr-sticky__value" id="amountFinanced">$0.00</span>
    </div>
  </div>

  <div class="calc-page__body">

    <!-- Loan Type Segmented Control -->
    <div class="apr-loan-type" role="tablist" aria-label="Loan Type">
      <button type="button" class="apr-loan-type__btn is-active" data-loan-type="CONV" role="tab" aria-selected="true">Conventional</button>
      <button type="button" class="apr-loan-type__btn" data-loan-type="FHA" role="tab" aria-selected="false">FHA</button>
      <button type="button" class="apr-loan-type__btn" data-loan-type="VA" role="tab" aria-selected="false">VA</button>
    </div>
    <input type="hidden" id="aprLoanType" value="CONV">

    <!-- Loan Information -->
    <div class="calc-section">
      <h2>Loan Information</h2>
      <div class="form-grid">
        <div class="form-group">
          <label for="loanAmount">Base Loan Amount ($)</label>
          <input type="number" id="loanAmount" value="0" min="0" step="1000" placeholder="Loan amount">
        </div>
        <div class="form-group">
          <label for="interestRate">Interest Rate (%)</label>
          <input type="number" id="interestRate" value="0" min="0" max="20" step="0.125" placeholder="e.g. 6.500">
        </div>
        <div class="form-group">
          <label for="loanTerm">Loan Term (Years)</label>
          <select id="loanTerm">
            <option value="10">10 Years</option>
            <option value="15">15 Years</option>
            <option value="20">20 Years</option>
            <option value="25">25 Years</option>
            <option value="30" selected>30 Years</option>
          </select>
        </div>
        <div class="form-group">
          <label for="discountPoints">Discount Points (%)</label>
          <input type="number" id="discountPoints" value="0" min="0" max="10" step="0.125">
        </div>
        <div class="form-group">
          <label for="propertyValue">Property Value ($) <span class="text-muted">(optional)</span></label>
          <input type="number" id="propertyValue" value="0" min="0" step="1000" placeholder="For LTV / MI">
        </div>
        <div class="form-group" id="vaUsageGroup" style="display:none">
          <label for="vaUsage">VA Usage</label>
          <select id="vaUsage">
            <option value="first">First-time use</option>
            <option value="subsequent">Subsequent use</option>
            <option value="exempt">Exempt</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Fee Group Filter Toolbar -->
    <div class="apr-fee-toolbar">
      <label class="apr-fee-toolbar__toggle">
        <input type="checkbox" id="aprFilterNonZero">
        Show only fees with values
      </label>
      <span class="apr-fee-toolbar__hint" id="aprFeeHint"></span>
    </div>

    <!-- Dynamic Fee Groups -->
    <div id="aprFeeGroups"></div>

    <!-- Credits -->
    <div class="calc-section">
      <h2>Credits</h2>
      <div class="form-grid">
        <div class="form-group">
          <label for="lenderCredit">Lender Credit ($)</label>
          <input type="number" id="lenderCredit" value="0" min="0" step="100">
        </div>
        <div class="form-group">
          <label for="sellerCredit">Seller Credit ($)</label>
          <input type="number" id="sellerCredit" value="0" min="0" step="100">
        </div>
      </div>
      <p class="text-muted text-sm">Lender credits reduce APR-classified fees dollar-for-dollar. Seller credits do not affect APR unless individual fees are marked seller-paid.</p>
    </div>

    <!-- Detailed Results / Cost Analysis -->
    <div class="calc-section">
      <h2>Cost Analysis</h2>
      <div id="aprWarning" class="apr-warning u-hidden">
        <strong>Warning:</strong> The APR is significantly higher than the note rate.
      </div>

      <div class="apr-comparison">
        <h3>APR vs Note Rate</h3>
        <div class="comparison-grid">
          <div class="comparison-item">
            <h4>Note Rate</h4>
            <div class="value" id="noteRateDisplay2">0.000%</div>
          </div>
          <div class="comparison-item">
            <h4>APR</h4>
            <div class="value" id="aprDisplay">0.000%</div>
          </div>
        </div>
        <div class="cost-of-fees">
          <div class="cost-row"><span class="cost-label">APR Spread:</span><span class="cost-value" id="aprSpread2">+0.000%</span></div>
          <div class="cost-row"><span class="cost-label">Total APR Fees:</span><span class="cost-value" id="totalUpfrontCosts">$0.00</span></div>
          <div class="cost-row"><span class="cost-label">Total Finance Charges:</span><span class="cost-value" id="financeCharges">$0.00</span></div>
          <div class="cost-row"><span class="cost-label">Effective Monthly Cost:</span><span class="cost-value" id="monthlyFeeCost">$0.00/mo</span></div>
        </div>
      </div>

      <%- include('../partials/calc-actions') %>
    </div>

    <%- include('../partials/show-calculations', { calcId: 'apr' }) %>
  </div>

  <div class="calc-page__footer">
    <div class="calc-page__footer-title">APR Calculation Method</div>
    <p>APR solved via bisection per Reg Z. Fee classification follows the MSFG fee catalog for Conventional, FHA, and VA. Monthly MI is included in the payment stream for the months it applies. Click any APR pill to manually override classification.</p>
  </div>
</div>

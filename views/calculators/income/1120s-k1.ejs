<div class="calc-page">
  <div class="calc-page__header">
    <h1>1120S K-1 Income Calculator</h1>
    <p>Calculate monthly income from S-Corporation K-1 distributions (Schedule K-1, Form 1120S).</p>
  </div>

  <div class="calc-page__body">

    <!-- Upload Zone -->
    <div class="calc-section">
      <h2>Upload Schedule K-1 (1120S)</h2>
      <p class="text-muted text-sm u-mb-sm">Upload Schedule K-1 pages from Form 1120S to auto-fill fields. Upload one per tax year (max 2).</p>

      <div class="upload-zone" data-upload-type="income-1120s-k1">
        <div class="upload-zone__icon">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <div class="upload-zone__text">
          <strong>Upload K-1 (1120S)</strong>
          <span>Drop or click to upload a K-1 image or PDF</span>
        </div>
        <input type="file" class="upload-zone__input u-hidden" accept="image/*,application/pdf">
        <div class="upload-zone__status"></div>
      </div>

      <!-- JS-rendered document cards -->
      <div id="docCards"></div>
    </div>

    <!-- Policy Explanation -->
    <div class="calc-section">
      <div class="policy-box">
        <h5>S-Corp K-1 Income Policy</h5>
        <p>
          S-Corp K-1 income includes ordinary business income/loss and rental income/loss.
          Unlike partnerships, S-Corps do not have guaranteed payments.
        </p>
      </div>

      <div class="info-note">
        <h5>W-2 Wages Note</h5>
        <p>
          S-Corporation shareholders receive wages via W-2, not guaranteed payments.
          Include W-2 wages from the 1040 calculator separately.
        </p>
      </div>
    </div>

    <!-- 1120S K-1 -->
    <div class="calc-section">
      <%- include('../../partials/income-name-field', { nameLabel: 'S-Corp Name' }) %>
      <%- include('../../partials/income-tax-year') %>

      <h2>1120S K-1</h2>
      <p class="text-muted text-sm u-mb-sm">Enter line items from the shareholder's Schedule K-1 (Form 1120S). Positive values are added; negative values reduce income.</p>

      <table class="income-table">
        <thead>
          <tr>
            <th>Description</th>
            <th>Line #</th>
            <th>Sign</th>
            <th>Year 1 (Most Recent)</th>
            <th>Year 2 (Prior)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Ordinary Business Income or Loss</td>
            <td class="line-number">1</td>
            <td class="sign-col add">+/&minus;</td>
            <td><input type="number" id="k1_ord1" value="0"></td>
            <td><input type="number" id="k1_ord2" value="0"></td>
          </tr>
          <tr>
            <td>Net Rental Real Estate Income/Loss</td>
            <td class="line-number">2</td>
            <td class="sign-col add">+/&minus;</td>
            <td><input type="number" id="k1_rent1" value="0"></td>
            <td><input type="number" id="k1_rent2" value="0"></td>
          </tr>
          <tr>
            <td>Other Net Rental Income/Loss</td>
            <td class="line-number">3</td>
            <td class="sign-col add">+/&minus;</td>
            <td><input type="number" id="k1_other1" value="0"></td>
            <td><input type="number" id="k1_other2" value="0"></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Result -->
    <div class="calc-section">
      <h2>Result</h2>

      <div class="result-highlight u-mt-lg">
        <div class="result-highlight__label">Monthly K-1 Income</div>
        <div class="result-highlight__value" id="combinedK1">$0.00</div>
      </div>

      <%- include('../../partials/calc-actions') %>
    </div>

    <%- include('../../partials/show-calculations', { calcId: 'income-1120s-k1' }) %>

  </div>

  <div class="calc-page__footer">
    <div class="calc-page__footer-title">1120S K-1 Guidelines</div>
    <p>
      Schedule K-1 (Form 1120S) reports each shareholder's share of S-Corporation income.
      Qualifying income includes ordinary business income/loss and rental real estate income/loss.
      S-Corporation shareholders receive wages separately via W-2 — those are entered in the 1040
      calculator, not here. If two years are provided and Year 1 exceeds Year 2, both years are
      averaged over 24 months; otherwise only the most recent year is used.
    </p>
  </div>
</div>
